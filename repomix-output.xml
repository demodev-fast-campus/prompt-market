  font-display: swap;
}

@custom-variant dark (&:is(.dark *));

:root {
  /* Updated color palette for Korean prompt marketplace */
  --background: oklch(1 0 0); /* #ffffff */
  --foreground: oklch(0.3 0 0); /* #374151 */
  --card: oklch(0.98 0.02 142); /* #f0fdf4 */
  --card-foreground: oklch(0.3 0 0); /* #374151 */
  --popover: oklch(1 0 0); /* #ffffff */
