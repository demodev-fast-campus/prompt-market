  --chart-3: oklch(0.55 0.22 25); /* #dc2626 */
  --chart-4: oklch(0.75 0.15 85); /* #84cc16 */
  --chart-5: oklch(0.85 0 0); /* #d1d5db */
  --radius: 0.5rem;
  --sidebar: oklch(0.98 0.02 142); /* #f0fdf4 */
  --sidebar-foreground: oklch(0.3 0 0); /* #374151 */
  --sidebar-primary: oklch(0.45 0.15 142); /* #15803d */
  --sidebar-primary-foreground: oklch(1 0 0); /* #ffffff */
  --sidebar-accent: oklch(0.75 0.15 85); /* #84cc16 */
  --sidebar-accent-foreground: oklch(0.3 0 0); /* #374151 */
  --sidebar-border: oklch(0.85 0 0); /* #d1d5db */
  --sidebar-ring: oklch(0.75 0.15 85); /* #84cc16 */
}

.dark {
