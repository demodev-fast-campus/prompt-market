      author: "운영자",
      createdAt: new Date().toISOString().slice(0, 10),
    }
    const updated = [next, ...storage.getPrompts<AdminPrompt>()]
    storage.setPrompts(updated)
    setPrompts(updated)
  }

  const handleDelete = (promptId: string) => {
