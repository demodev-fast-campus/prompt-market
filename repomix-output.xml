  --primary: oklch(0.45 0.15 142); /* #15803d */
  --primary-foreground: oklch(1 0 0); /* #ffffff */
  --secondary: oklch(0.75 0.15 85); /* #84cc16 */
  --secondary-foreground: oklch(0.3 0 0); /* #374151 */
  --muted: oklch(0.98 0.02 142); /* #f0fdf4 */
  --muted-foreground: oklch(0.3 0 0); /* #374151 */
  --accent: oklch(0.75 0.15 85); /* #84cc16 */
  --accent-foreground: oklch(0.3 0 0); /* #374151 */
  --destructive: oklch(0.55 0.22 25); /* #dc2626 */
  --destructive-foreground: oklch(1 0 0); /* #ffffff */
  --border: oklch(0.85 0 0); /* #d1d5db */
  --input: oklch(1 0 0); /* #ffffff */
  --ring: oklch(0.75 0.15 85); /* #84cc16 */
