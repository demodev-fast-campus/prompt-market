  }

  const handleDownload = (downloadUrl: string, title: string) => {
    // Handle download logic
    console.log(`Downloading: ${title} from ${downloadUrl}`)
  }

  const items = useMemo(() => {
    const list = purchases.map((p) => ({
      id: p.id,
      title: p.title ?? "구매한 프롬프트",
